{
  "name": "@settle/circle",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "node": "./src/index.ts"
    }
  },
  "scripts": {
    "config:check": "node --env-file-if-exists=../../.env scripts/check-config.ts",
    "wallet:plan": "node --env-file-if-exists=../../.env scripts/create-deployer-wallet.ts",
    "wallet:create": "node --env-file-if-exists=../../.env scripts/create-deployer-wallet.ts",
    "contract:prepare": "node --env-file-if-exists=../../.env scripts/prepare-contract-deployment.ts",
    "contract:estimate": "node --env-file-if-exists=../../.env scripts/estimate-contract-deployment.ts",
    "contract:deploy": "node --env-file-if-exists=../../.env scripts/deploy-contract.ts",
    "contract:status": "node --env-file-if-exists=../../.env scripts/check-contract-deployment.ts",
    "contract:integrity": "node --env-file-if-exists=../../.env scripts/check-settlement-integrity.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "10.8.0",
    "@circle-fin/smart-contract-platform": "10.8.0",
    "@noble/hashes": "2.0.1",
    "@settle/shared": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "^5.9.0"
  }
}