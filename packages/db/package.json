{
  "name": "@settle/db",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./api-keys": {
      "react-server": "./src/api-keys.ts",
      "node": "./src/api-keys.ts"
    },
    "./api-key-service": {
      "react-server": "./src/api-key-service.ts",
      "node": "./src/api-key-service.ts"
    },
    "./client": {
      "react-server": "./src/client.ts",
      "node": "./src/client.ts"
    },
    "./config": {
      "react-server": "./src/config.ts",
      "node": "./src/config.ts"
    },
    "./payment-intent-service": {
      "react-server": "./src/payment-intent-service.ts",
      "node": "./src/payment-intent-service.ts"
    },
    "./rate-limit-service": {
      "react-server": "./src/rate-limit-service.ts",
      "node": "./src/rate-limit-service.ts"
    },
    "./arc-reconciliation-worker": {
      "react-server": "./src/arc-reconciliation-worker.ts",
      "node": "./src/arc-reconciliation-worker.ts"
    },
    "./reconciliation-policy": {
      "react-server": "./src/reconciliation-policy.ts",
      "node": "./src/reconciliation-policy.ts"
    },
    "./webhook-delivery-worker": {
      "react-server": "./src/webhook-delivery-worker.ts",
      "node": "./src/webhook-delivery-worker.ts"
    },
    "./webhook-security": {
      "react-server": "./src/webhook-security.ts",
      "node": "./src/webhook-security.ts"
    },
    "./webhook-service": {
      "react-server": "./src/webhook-service.ts",
      "node": "./src/webhook-service.ts"
    },
    "./repositories": {
      "react-server": "./src/repositories/index.ts",
      "node": "./src/repositories/index.ts"
    },
    "./schema": {
      "react-server": "./src/schema/index.ts",
      "node": "./src/schema/index.ts"
    },
    "./transaction": {
      "react-server": "./src/transaction.ts",
      "node": "./src/transaction.ts"
    },
    "./types": "./src/types.ts"
  },
  "scripts": {
    "config:check": "node --env-file-if-exists=../../.env --conditions=react-server scripts/check-config.ts",
    "webhooks:config:check": "node --env-file-if-exists=../../.env --conditions=react-server scripts/check-webhook-config.ts",
    "reconciliation:config:check": "node --env-file-if-exists=../../.env --conditions=react-server scripts/check-reconciliation-config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts --name=m1_e_reconciliation",
    "db:migrate": "node --env-file-if-exists=../../.env --conditions=react-server scripts/migrate.ts",
    "db:validate": "node --env-file-if-exists=../../.env --conditions=react-server scripts/validate-development.ts",
    "merchant:bootstrap:test": "node --env-file-if-exists=../../.env --conditions=react-server scripts/bootstrap-test-merchant.ts",
    "webhooks:work": "node --env-file-if-exists=../../.env --conditions=react-server scripts/process-webhooks.ts",
    "reconciliation:work": "node --env-file-if-exists=../../.env --conditions=react-server scripts/reconcile-arc.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --test tests/*.unit.test.ts",
    "test:integration": "node --env-file-if-exists=../../.env --conditions=react-server --test tests/*.integration.test.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@settle/shared": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.0"
  }
}
